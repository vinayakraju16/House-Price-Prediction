# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_PATH=

# PostgreSQL override. POSTGRES_PASSWORD is required by docker-compose.postgres.yml.
POSTGRES_DB=house_price
POSTGRES_USER=house_price
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Use require or verify-full with a managed production database. Local Compose uses disable.
POSTGRES_SSLMODE=

# TLS/security settings for a production reverse proxy.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_TRUST_PROXY_PROTO=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# Optional model pin. Leave blank to use model_registry.json active_version.
MODEL_VERSION=

# Protect /monitoring/ outside local development.
MONITORING_API_KEY=replace-with-a-random-monitoring-key

# Optional market context providers.
CENSUS_API_KEY=
FRED_API_KEY=

# React/Vite API origin. Docker Compose defaults this to the same-origin /api proxy.
VITE_API_URL=http://localhost:8000

# Optional MLflow training integration.
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=house-price-seattle
